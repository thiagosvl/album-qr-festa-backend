{
  "name": "album-qr-festa-backend",
  "version": "1.0.0",
  "description": "Backend API da plataforma Álbum QR Festa (Fastify + TypeScript + Zod + Supabase)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@supabase/supabase-js": "2.79.0",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.3",
    "fastify": "5.6.1",
    "pino": "^10.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.10.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "cookie": "1.0.2"
  }
}
